    {
      "id": 5,
      "type": "barchart",
      "title": "Преподавателей по экспертизам",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "teachers-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "teachers-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.name AS \"Экспертиза\", count(*) AS \"Преподавателей\" FROM teacher_has_teacher_expertises t JOIN expertises e ON e.id = t.expertise_id GROUP BY e.name ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "showValue": "auto"
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Средняя ставка в час по экспертизам",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "teachers-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "teachers-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.name AS \"Экспертиза\", round(avg(c.rate_per_hour)::numeric, 2) AS \"Средняя ставка\" FROM teacher_has_teacher_expertises t JOIN expertises e ON e.id = t.expertise_id JOIN cv c ON c.teacher_id = t.teacher_id GROUP BY e.name ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "showValue": "auto"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Топ преподавателей",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "teachers-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "teachers-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT u.name AS \"Имя\", c.name AS \"Город\", t.rating AS \"Рейтинг\", cv.rate_per_hour AS \"Ставка/час\", cv.years_of_experience AS \"Опыт, лет\" FROM teachers t JOIN users u ON u.id = t.related_user_id LEFT JOIN city c ON c.id = u.city_id LEFT JOIN cv ON cv.teacher_id = t.id ORDER BY t.rating DESC NULLS LAST, cv.rate_per_hour DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Пользователи по городам",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "teachers-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "teachers-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(c.name, 'Не указан') AS \"Город\", count(*) AS \"Пользователей\" FROM users u LEFT JOIN city c ON c.id = u.city_id GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Платежи по дням",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "teachers-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "teachers-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), count(*) AS \"Платежей\", coalesce(sum(\"sum\"), 0) AS \"Сумма\" FROM payment WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
